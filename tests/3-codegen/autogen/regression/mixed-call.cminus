float mix(int a, float b, int c, float d, int e, float f, int g,
          float h, int i, float j, int k, float l, int m, float n,
          int o, float p) {
    return a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p;
}

float recurse(int n, float x) {
    if (n == 0)
        return x;
    else
        return x + recurse(n - 1, x + 0.5);
}

int main(void) {
    float saved;
    saved = mix(1, 2.0, 3, 4.0, 5, 6.0, 7, 8.0,
                9, 10.0, 11, 12.0, 13, 14.0, 15, 16.0);
    outputFloat(saved + recurse(3, 1.0));
    return 0;
}
